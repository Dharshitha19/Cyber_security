
import re
import secrets
import string
import tkinter as tk
from tkinter import ttk

COMMON_PASSWORDS = {
    "password", "password123", "123456", "123456789",
    "qwerty", "admin", "letmein", "welcome",
    "iloveyou", "abc123", "111111", "passw0rd"
}


def analyze_password(password):
    """Analyze password strength and return score, rating and suggestions."""

    checks = {
        "At least 12 characters": len(password) >= 12,
        "Lowercase letters": bool(re.search(r"[a-z]", password)),
        "Uppercase letters": bool(re.search(r"[A-Z]", password)),
        "Numbers": bool(re.search(r"\d", password)),
        "Special characters": bool(re.search(r"[^A-Za-z0-9]", password)),
        "No three repeated characters": not bool(re.search(r"(.)\1\1", password)),
        "Not a common password": password.lower() not in COMMON_PASSWORDS
    }

    if not password:
        return 0, "Enter a password", checks, [
            "Enter a sample password to analyze."
        ]

    score = 0

    # Check password length
    if len(password) >= 16:
        score += 35
    elif len(password) >= 12:
        score += 28
    elif len(password) >= 8:
        score += 18
    else:
        score += 8

    # Check character variety
    if re.search(r"[a-z]", password):
        score += 10
    if re.search(r"[A-Z]", password):
        score += 10
    if re.search(r"\d", password):
        score += 10
    if re.search(r"[^A-Za-z0-9]", password):
        score += 15
    if len(set(password)) >= 8:
        score += 10
    if len(password) >= 20:
        score += 10

    # Detect predictable patterns
    lowered = password.lower()

    if re.search(r"(.)\1\1", password):
        score -= 10

    if any(pattern in lowered for pattern in
           ["1234", "abcd", "qwerty", "password"]):
        score -= 15

    if lowered in COMMON_PASSWORDS:
        score = min(score, 15)

    score = max(0, min(100, score))

    if score < 35:
        rating = "Weak"
    elif score < 65:
        rating = "Moderate"
    elif score < 85:
        rating = "Strong"
    else:
        rating = "Very Strong"

    suggestions = []

    if len(password) < 12:
        suggestions.append("Use at least 12 characters.")
    if not re.search(r"[a-z]", password):
        suggestions.append("Add lowercase letters.")
    if not re.search(r"[A-Z]", password):
        suggestions.append("Add uppercase letters.")
    if not re.search(r"\d", password):
        suggestions.append("Add numbers.")
    if not re.search(r"[^A-Za-z0-9]", password):
        suggestions.append("Add special characters like !, @ or #.")
    if re.search(r"(.)\1\1", password):
        suggestions.append("Avoid repeating the same character.")
    if any(pattern in lowered for pattern in
           ["1234", "abcd", "qwerty", "password"]):
        suggestions.append("Avoid predictable words and sequences.")
    if lowered in COMMON_PASSWORDS:
        suggestions.append("Choose a unique password, not a common one.")

    if not suggestions:
        suggestions.append(
            "Good job! Keep this password unique and do not reuse it."
        )

    return score, rating, checks, suggestions


def generate_password(length=18):
    """Generate a random password using Python's secure secrets module."""

    characters = (
        string.ascii_lowercase
        + string.ascii_uppercase
        + string.digits
        + "!@#$%^&*()-_=+?"
    )

    while True:
        password = "".join(
            secrets.choice(characters) for _ in range(length)
        )

        if (
            re.search(r"[a-z]", password)
            and re.search(r"[A-Z]", password)
            and re.search(r"\d", password)
            and re.search(r"[^A-Za-z0-9]", password)
        ):
            return password


class PasswordAnalyzer:
    def __init__(self, root):
        self.root = root
        self.root.title("Password Strength Analyzer")
        self.root.geometry("650x620")
        self.root.configure(bg="#f1f5f9")

        self.password_var = tk.StringVar()
        self.show_var = tk.BooleanVar(value=False)

        title = tk.Label(
            root,
            text="Password Strength Analyzer",
            font=("Arial", 21, "bold"),
            bg="#f1f5f9",
            fg="#1e3a8a"
        )
        title.pack(pady=(20, 5))

        subtitle = tk.Label(
            root,
            text="Check your password security and get suggestions",
            font=("Arial", 10),
            bg="#f1f5f9",
            fg="#475569"
        )
        subtitle.pack(pady=(0, 20))

        self.entry = tk.Entry(
            root,
            textvariable=self.password_var,
            show="*",
            font=("Arial", 13),
            width=38
        )
        self.entry.pack(pady=5, ipady=6)

        tk.Checkbutton(
            root,
            text="Show password",
            variable=self.show_var,
            command=self.toggle_password,
            bg="#f1f5f9"
        ).pack()

        button_frame = tk.Frame(root, bg="#f1f5f9")
        button_frame.pack(pady=12)

        ttk.Button(
            button_frame,
            text="Analyze Password",
            command=self.analyze
        ).pack(side="left", padx=4)

        ttk.Button(
            button_frame,
            text="Generate Password",
            command=self.generate
        ).pack(side="left", padx=4)

        ttk.Button(
            button_frame,
            text="Clear",
            command=self.clear
        ).pack(side="left", padx=4)

        self.rating = tk.Label(
            root,
            text="Strength: Not analyzed",
            font=("Arial", 14, "bold"),
            bg="#f1f5f9"
        )
        self.rating.pack(pady=(12, 5))

        self.progress = ttk.Progressbar(
            root,
            length=420,
            maximum=100,
            mode="determinate"
        )
        self.progress.pack(pady=5)

        self.score_label = tk.Label(
            root,
            text="Score: 0 / 100",
            font=("Arial", 10),
            bg="#f1f5f9"
        )
        self.score_label.pack(pady=5)

        tk.Label(
            root,
            text="Security Checklist",
            font=("Arial", 12, "bold"),
            bg="#f1f5f9"
        ).pack(pady=(10, 4))

        self.output = tk.Text(
            root,
            height=8,
            width=65,
            font=("Arial", 10),
            wrap="word"
        )
        self.output.pack(padx=18, pady=4)

        tk.Label(
            root,
            text="Privacy: passwords are analyzed locally and not saved.",
            font=("Arial", 9),
            fg="#475569",
            bg="#f1f5f9"
        ).pack(pady=8)

        self.set_output("Enter a sample password and click Analyze Password.")

    def toggle_password(self):
        self.entry.config(
            show="" if self.show_var.get() else "*"
        )

    def set_output(self, text):
        self.output.config(state="normal")
        self.output.delete("1.0", tk.END)
        self.output.insert(tk.END, text)
        self.output.config(state="disabled")

    def analyze(self):
        password = self.password_var.get()

        score, rating, checks, suggestions = analyze_password(password)

        self.rating.config(text=f"Strength: {rating}")
        self.progress["value"] = score
        self.score_label.config(text=f"Score: {score} / 100")

        result = "CHECKLIST\n"
        for name, passed in checks.items():
            result += ("[PASS] " if passed else "[FAIL] ") + name + "\n"

        result += "\nSUGGESTIONS\n"
        for suggestion in suggestions:
            result += "- " + suggestion + "\n"

        self.set_output(result)

    def generate(self):
        password = generate_password()
        self.password_var.set(password)
        self.show_var.set(True)
        self.toggle_password()
        self.analyze()
        self.entry.focus_set()
        self.entry.select_range(0, tk.END)

    def clear(self):
        self.password_var.set("")
        self.show_var.set(False)
        self.toggle_password()
        self.rating.config(text="Strength: Not analyzed")
        self.progress["value"] = 0
        self.score_label.config(text="Score: 0 / 100")
        self.set_output(
            "Enter a sample password and click Analyze Password."
        )
        self.entry.focus_set()


if __name__ == "__main__":
    window = tk.Tk()
    app = PasswordAnalyzer(window)
    window.mainloop()
